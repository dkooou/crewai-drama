# Copy to .env and fill in your keys
# cp .env.example .env

# ── Required ────────────────────────────────────
# OpenRouter (routes to GPT, Claude, Gemini via single key)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Telegram Bot (for phone access)
# 1. Find @BotFather on Telegram, send /newbot to get a token
# 2. Start the bot, send /start, check logs for your user_id
TELEGRAM_BOT_TOKEN=your-bot-token
ALLOWED_USER_IDS=your-telegram-user-id

# ── Memory (cross-task learning) ───────────────
# Google AI — ONLY for embeddings (text-embedding-004)
# Get a free key at aistudio.google.com → Get API key
# Free: 1500 requests/day, no credit card needed
GOOGLE_API_KEY=AIza-your-google-key-here

# ── Intelligence Layer (for creative_intel agent) ─
# Tavily — web search API (sign up at tavily.com)
TAVILY_API_KEY=tvly-your-key-here

# TikHub — TikTok/Douyin data API (you already have this)
# If ~/.config/tikhub/key exists, it's read automatically.
# Otherwise set it here:
# TIKHUB_API_KEY=your-tikhub-key

# ── Optional ────────────────────────────────────
# Knowledge base directory for intelligence reports
# KNOWLEDGE_BASE_DIR=knowledge_base
